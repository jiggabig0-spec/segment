# Solana RPC endpoint. Defaults to public devnet.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Shown in the header so nobody confuses test and real money.
NEXT_PUBLIC_NETWORK_LABEL=Devnet
# Deployed program id. Defaults to the id in src/idl/segments.json.
# NEXT_PUBLIC_PROGRAM_ID=
# Set to 1 to run on built-in Alphabet data with a pretend wallet (no deployed program needed).
# NEXT_PUBLIC_DEMO=1
